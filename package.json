{
  "name": "frontend-machine-coding",
  "version": "1.0.0",
  "description": "A collection of frontend machine coding implementations built using React, TypeScript, and modern frontend engineering practices. Focused on scalable UI architecture, performance optimization, reusable components, clean code structure, and production-level frontend development patterns.",
